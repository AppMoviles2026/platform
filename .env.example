# Copy to .env in this backend's root. Sandbox credentials only; do not publish .env.
PAYPAL_ENABLED=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_URL=http://localhost:8081/api/v1/billing/paypal/callback
PAYPAL_IDENTITY_RETURN_URL=http://localhost:8081/api/v1/billing/paypal/identity-callback
# Outside local development set a random stable 32-byte Base64 encryption key.
# BILLING_ENCRYPTION_KEY=
# Subscription plans are provisioned with scripts/initialize-paypal-subscriptions.ps1.
PAYPAL_SUBSCRIPTION_RETURN_URL=http://localhost:8081/api/v1/billing/paypal/subscription-callback
PAYPAL_ESSENTIAL_PLAN_ID=
PAYPAL_GROWTH_PLAN_ID=
BILLING_DEMO_CATALOG_ENABLED=true
BILLING_ESSENTIAL_AMOUNT=5.00
BILLING_GROWTH_AMOUNT=10.00
# Collaboration compensation; Orders and Payouts stay in Sandbox.
PAYPAL_COMPENSATION_RETURN_URL=http://localhost:8081/api/v1/billing/paypal/compensation-callback
BILLING_COMPENSATION_ENABLED=true
BILLING_COMPENSATION_CURRENCIES=USD
BILLING_COMPENSATION_BATCH_SIZE=50
BILLING_ORDER_RETRY_SECONDS=18000
BILLING_PAYOUT_RETRY_SECONDS=2419200
BILLING_COMPENSATION_SCHEDULING_ENABLED=true
BILLING_AUTOMATIC_PAYOUTS=true
