# Copy to .env in this backend's root. Sandbox credentials only; do not publish .env.
PAYPAL_ENABLED=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_URL=http://localhost:8081/api/v1/billing/paypal/callback
PAYPAL_IDENTITY_RETURN_URL=http://localhost:8081/api/v1/billing/paypal/identity-callback
# Outside local development set a random stable 32-byte Base64 encryption key.
# BILLING_ENCRYPTION_KEY=
